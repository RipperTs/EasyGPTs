            "key": "code",
            "renderTypeList": [
              "custom"
            ],
            "label": "",
            "valueType": "string",
            "value": "import time\nimport jionlp as jio\nfrom datetime import datetime\n\n\ndef get_time_entities(text: str, only_date: int = 0) -> str:\n    time_entities = jio.ner.extract_time(text, time_base=time.time(), with_parsing=False)\n    if len(time_entities) == 0:\n        return text\n\n    now_time = time.time()\n    new_text = text\n\n    # 偏移量修正值，用于调整索引\n    offset_correction = 0\n\n    for time_entity in time_entities:\n        try:\n            parse_time_util = jio.parse_time(time_entity['text'], time_base=now_time, time_type=time_entity['type'])\n            start_time = parse_time_util['time'][0]\n            end_time = parse_time_util['time'][1]\n\n            # 解析时间字符串为 datetime 对象\n            time_format = \"%Y-%m-%d %H:%M:%S\"\n            dt1 = datetime.strptime(start_time, time_format)\n            dt2 = datetime.strptime(end_time, time_format)\n            new_date_str = f\"{dt1} 到 {dt2}\"\n            if only_date == 1:\n                if dt1.date() == dt2.date():\n                    new_date_str = f\"{dt1.date()}\"\n                else:\n                    new_date_str = f\"{dt1.date()} 到 {dt2.date()}\"\n\n            offset = time_entity['offset']\n            start_idx = offset[0] + offset_correction\n            end_idx = offset[1] + offset_correction\n            original_str = new_text[start_idx:end_idx]\n\n            # 替换文本\n            new_text = new_text[:start_idx] + new_date_str + new_text[end_idx:]\n\n            # 更新偏移量修正值\n            offset_correction += len(new_date_str) - len(original_str)\n\n        except Exception as e:\n            print(e)\n            continue\n\n    return new_text\n\n\ndef main(text, only_date):\n    result = get_time_entities(text, only_date)\n    return {\n        \"result\": result,\n    }\n",
