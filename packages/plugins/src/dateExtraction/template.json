            "key": "code",
            "renderTypeList": [
              "custom"
            ],
            "label": "",
            "valueType": "string",
            "value": "import time\nimport jionlp as jio\nfrom datetime import datetime\nfrom typing import List\n\n\ndef get_time_entities(text: str, only_date: int = 0) -> List[List[str]]:\n    time_entities = jio.ner.extract_time(text, time_base=time.time(), with_parsing=False)\n    if not time_entities:\n        return []\n\n    now_time = time.time()\n    results: List[List[str]] = []\n\n    for time_entity in time_entities:\n        try:\n            parsed = jio.parse_time(\n                time_entity['text'], time_base=now_time, time_type=time_entity['type']\n            )\n            start_time = parsed['time'][0]\n            end_time = parsed['time'][1]\n\n            time_format = \"%Y-%m-%d %H:%M:%S\"\n            dt_start = datetime.strptime(start_time, time_format)\n            dt_end = datetime.strptime(end_time, time_format)\n\n            if only_date == 1:\n                results.append([\n                    dt_start.strftime(\"%Y-%m-%d\"),\n                    dt_end.strftime(\"%Y-%m-%d\"),\n                ])\n            else:\n                results.append([\n                    dt_start.strftime(time_format),\n                    dt_end.strftime(time_format),\n                ])\n        except Exception as e:\n            continue\n\n    return results\n\n\ndef main(text, only_date):\n    result = get_time_entities(text, only_date=only_date)\n    return {\n        \"result\": result,\n    }\n",
