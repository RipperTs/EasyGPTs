          {
            "key": "code",
            "renderTypeList": [
              "custom"
            ],
            "label": "",
            "value": "function main({documents, score, relevance_result}){\n\n    if (!relevance_result?.results || relevance_result?.results?.length === 0) {\n      return {\n        result: [],\n        raw_response: relevance_result,\n        score\n      }\n    }\n\n    const result = [];\n    for (let i = 0; i < relevance_result.results.length; i++) {\n      const item = relevance_result.results[i];\n      if(item.relevance_score > score){\n        result.push(documents[item.index]);\n      }\n    }\n\n    return {\n      result,\n      raw_response: relevance_result,\n      score\n    }\n  }",
            "valueDesc": "",
            "description": "",
            "debugLabel": "",
            "toolDescription": ""
